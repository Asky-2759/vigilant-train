# ─── ElevenLabs ──────────────────────────────────────────────────────────────
# Without a key the tool still works: the bundled gTTS voice speaks and scores
# the reference instead.
ELEVENLABS_API_KEY=

# Starting voice. Leave blank for "Lower Male Voice"; the picker in the page
# header switches between the four voices without a restart.
ELEVENLABS_VOICE_ID=

# Voice that speaks the phrase. eleven_multilingual_v2 is the quality default.
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# Only some models honour <phoneme alphabet="ipa"> tags, which is what the
# "Hear the sounds only" button uses. flash v2 and the v3 family do; the
# multilingual models silently drop the tagged word.
ELEVENLABS_PHONEME_MODEL_ID=eleven_flash_v2

ELEVENLABS_STABILITY=0.5
ELEVENLABS_SIMILARITY_BOOST=0.75
# Speed for the "Slowly" button. ElevenLabs accepts 0.7-1.2.
ELEVENLABS_SLOW_SPEED=0.7

# ─── Scoring ─────────────────────────────────────────────────────────────────
PRONOUNCE_HOST=127.0.0.1
PRONOUNCE_PORT=8077

# The acoustic term of the score maps "embedding distance from the reference"
# to 0-100, and OpenPronounce's defaults were measured with gTTS as the
# reference. With an ElevenLabs voice the honest value is slightly different --
# run `python calibrate.py` and paste what it prints here.
#ACOUSTIC_GOOD=6.0

# cpu | cuda | mps. Auto-detected when unset.
#OPENPRONOUNCE_DEVICE=cpu
# Set to "off" to skip phone-level recognition (faster, much less feedback).
#OPENPRONOUNCE_PHONEME_MODEL=off
